# .env.example
# ──────────────────────────────────────────────────────────────
# Technopaths Quota — required configuration values
#
# IMPORTANT: GitHub Pages serves plain static files, so a browser
# can never read a real .env file at runtime — there is no server
# to load it. This file exists as the single documented source of
# truth for every value the app needs; where each one actually goes
# is noted next to it.
# ──────────────────────────────────────────────────────────────

# Google Sheet ID (the database).
# → Goes into: Apps Script Project Settings → Script Properties → SPREADSHEET_ID
# → How to find it: see README.md "Finding your Spreadsheet ID"
SPREADSHEET_ID=1MTIf_XbAACroF8TYBS2X5CZAkrhy6H-j4qX9kNaIsRo

# Deployed Apps Script Web App URL (ends in /exec).
# → Goes into: config.js → TQ_CONFIG.API_BASE  (copy config.example.js → config.js first)
# → How to find it: see README.md "Deploying the backend"
API_BASE=https://script.google.com/macros/s/AKfycby3VnGK2SK6h8Ggll_gsRCCKSoM9Y2-rmjbKe79XqPPX77FrUfm3fdriRu3e0dya1FV/exec

# Login credentials (temporary hardcoded-auth approach, per current design).
# → Goes into: index.html, near the top of the <script> block
#   (kept out of script.js/config.js so it's obvious it's not a real auth system)
LOGIN_USERNAME=
LOGIN_PASSWORD=
